/rust/target
/target

# Endpoint private keys generated by the camera apps / isekai-p2p CLIs and the
# relay_e2e example (load_or_generate_key). Long-lived secrets — never commit.
*-endpoint.pem
e2e-server.pem
e2e-client.pem

# iOS build outputs. `ios/build-rust.sh` writes the bindings and the
# xcframework; `xcodegen generate` writes the project and its Info.plist. Only
# ios/project.yml and ios/IsekaiCameraClient/App are tracked.
/ios/IsekaiCameraClient.xcodeproj/
/ios/IsekaiCameraClient/Generated/
/ios/IsekaiCameraClient/Frameworks/
/ios/IsekaiCameraClient/Info.plist
/ios/DerivedData/

# QUIC trace artifacts written by msquic (ETW logging) when running the camera
# apps. Generated on demand; never committed.
quic.etl
quic.txt
